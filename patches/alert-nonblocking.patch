+<script>
+(()=>{if(document.getElementById("grokAlertLayout"))return;
+const s=document.createElement("style");s.id="grokAlertLayout";s.textContent=`
+/* Grok: keep 5-min match alerts from covering map, dice, and roll controls */
+body.ui-battle-v2 .toast{top:auto!important;bottom:calc(var(--v2-footer-h,40px) + 64px)!important;left:8px!important;right:auto!important;transform:none!important;max-width:min(72vw,280px)!important;pointer-events:none!important;z-index:46!important}
+body.ui-battle-v2 .toast.show{transform:none!important}
+body.ui-battle-v2 .banner-big{top:18%!important;font-size:22px!important;pointer-events:none!important;z-index:45!important}
+body.ui-battle-v2 .parry{top:22%!important;pointer-events:none!important}
+#heroMoment{top:calc(env(safe-area-inset-top,0px) + 86px)!important;transform:translate(-50%,0) scale(.86)!important;z-index:47!important;pointer-events:none!important;max-width:min(88vw,320px)}
+#heroMoment.show{transform:translate(-50%,0) scale(1)!important}
+#battleAtmos{z-index:12!important;pointer-events:none!important}
+#tacticalV2{min-height:0!important;max-height:52px;margin:2px 7px 3px!important;padding:4px 7px!important;pointer-events:none}
+#tacticalV2 #tacticalActionV2{pointer-events:auto}
+#tacticalV2[hidden]{display:none!important;margin:0!important;padding:0!important;min-height:0!important;border:0!important}
+#rivalMiniV2{position:absolute!important;right:6px!important;top:6px!important;width:118px!important;min-height:0!important;padding:3px 5px!important;grid-template-columns:28px 1fr!important;z-index:30;pointer-events:auto;background:#0c1a22ee}
+#rivalMiniV2 canvas{width:28px!important;height:28px!important}
+#battleGiftToastV2{position:relative!important;left:auto!important;right:auto!important;bottom:auto!important;margin:0 8px 6px!important;z-index:35;pointer-events:auto}
+#battleGiftToastV2.compact{width:auto!important}
+body.ui-battle-v2 #ultBtn:not([hidden]){bottom:calc(var(--v2-footer-h,40px) + 8px)!important;z-index:36!important}
+#battleExcitement{pointer-events:none!important;width:min(94vw,420px)!important;top:auto!important;bottom:calc(var(--v2-footer-h,40px) + 8px)!important;left:50%!important;transform:translateX(-50%)!important;z-index:34}
+#battleOrder,#battleAlert{pointer-events:none!important;margin-top:4px!important;max-height:46px;overflow:hidden}
+#battleOrder button,#battleAlert button{pointer-events:auto!important}
+#rivalChip{pointer-events:auto!important;top:auto!important;bottom:0!important;right:0!important}
+@media(min-width:900px){
+  body.ui-battle-v2 #tacticalV2{position:relative!important;left:auto!important;top:auto!important;width:auto!important;margin:2px 7px 3px!important}
+  body.ui-battle-v2 #rivalMiniV2{position:absolute!important;right:8px!important;top:8px!important;width:140px!important}
+}
+@media(max-height:760px){
+  #tacticalV2{max-height:36px!important}
+  body.ui-battle-v2 .toast{bottom:calc(var(--v2-footer-h,35px) + 52px)!important}
+}
+`;document.head.appendChild(s);
+const moveGift=()=>{
+  const gift=document.getElementById("battleGiftToastV2");
+  const foot=document.getElementById("battleFooterV2");
+  const battle=document.getElementById("battle");
+  if(gift&&foot&&battle&&gift.parentElement===battle){battle.insertBefore(gift,foot);}
+};
+moveGift();
+const mo=new MutationObserver(moveGift);
+if(document.getElementById("battle"))mo.observe(document.getElementById("battle"),{childList:true});
+})();
+</script>

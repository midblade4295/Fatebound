# Optional overrides for /etc/fatebound-siege.env
# SIEGE_MAX_PLAYERS=10   # humans in one match room (the 5v5: at most 10; the service file's 32 is from 16v16 and is capped)
# SIEGE_MAX_ROOMS=24     # 0.31.119: matches at once. 0.31.209: by default 6 a CPU core (the rooms step on every core);
#                        # a 5v5 room is ~12-15% of a core and ~110 kB/s out with ten phones. Whatever the cap, a room
#                        # opens only while the rooms stay within SIEGE_LOAD_LIMIT of the cores:
# SIEGE_LOAD_LIMIT=0.75  # 0.31.209: the share of all the cores the rooms may keep busy (the main loop has the rest)
# SIEGE_THREADS=0        # 0.31.209: every room on the main loop, as before (one core) -- only if threads misbehave
# SIEGE_LOG=1
# Purchase checks (0.31.90). The key normally comes from LoadCredential (see the service file); for testing only:
# SIEGE_IAP_FAKE=1     # accept every purchase without asking Google -- internal testing only, never live
# App Store purchase checks (0.31.131, the iOS port). The key itself (.p8) is /etc/fatebound-siege/appstore-key.p8
# (root-only), handed over by LoadCredential; these say which key it is (App Store Connect > Users and Access >
# Integrations > In-App Purchase):
# SIEGE_APPSTORE_ISSUER=<issuer id>
# SIEGE_APPSTORE_KEY_ID=<key id>

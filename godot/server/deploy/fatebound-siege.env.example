# Optional overrides for /etc/fatebound-siege.env
# SIEGE_MAX_PLAYERS=32   # humans in one match room (16v16)
# SIEGE_MAX_ROOMS=6      # 0.31.119: matches at once (0.31.151: default 6, was 4 -- battles on the war map use every
#                        # room); each full room is ~9% of a CPU core and ~350 kB/s out
# SIEGE_LOG=1
# Purchase checks (0.31.90). The key normally comes from LoadCredential (see the service file); for testing only:
# SIEGE_IAP_FAKE=1     # accept every purchase without asking Google -- internal testing only, never live
# App Store purchase checks (0.31.131, the iOS port). The key itself (.p8) is /etc/fatebound-siege/appstore-key.p8
# (root-only), handed over by LoadCredential; these say which key it is (App Store Connect > Users and Access >
# Integrations > In-App Purchase):
# SIEGE_APPSTORE_ISSUER=<issuer id>
# SIEGE_APPSTORE_KEY_ID=<key id>

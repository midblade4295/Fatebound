# Optional overrides for /etc/fatebound-siege.env
# SIEGE_MAX_PLAYERS=32   # humans in one match room (16v16)
# SIEGE_MAX_ROOMS=4      # 0.31.119: matches at once; each full room is ~9% of a CPU core and ~350 kB/s out
# SIEGE_LOG=1
# Purchase checks (0.31.90). The key normally comes from LoadCredential (see the service file); for testing only:
# SIEGE_IAP_FAKE=1     # accept every purchase without asking Google -- internal testing only, never live

[application]
config/name="Fatebound"
config/icon="res://assets/branding/icon.png"
config/description="Fatebound native game client — Play testing build."
run/main_scene="res://scenes/Boot.tscn"
boot_splash/bg_color=Color(0.07, 0.04, 0.06, 1)
boot_splash/image="res://assets/branding/splash_land.png"
boot_splash/stretch_mode=4

[autoload]

BootGuard="*res://scripts/app/boot_guard.gd"

[display]
window/size/viewport_width=760
window/size/viewport_height=420
window/size/window_width_override=1520
window/size/window_height_override=840
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
textures/vram_compression/import_etc2_astc=true
textures/webp_compression/compression_method=6
textures/webp_compression/lossless_compression_factor=100.0
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=false
rendering_device/pipeline_cache/save_chunk_size_mb=0.1
textures/default_filters/use_nearest_mipmap_filter=false

[gui]
common/snap_controls_to_pixels=false
theme/default_font_multichannel_signed_distance_field=true

[physics]

3d/physics_engine="Jolt Physics"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg", "res://addons/FateboundNotify/plugin.cfg")

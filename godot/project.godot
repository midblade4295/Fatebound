[application]
config/name="Fatebound"
config/icon="res://assets/branding/icon.png"
config/description="Fatebound native game client — Play testing build."
run/main_scene="res://scenes/Main.tscn"
config/project_settings_override="user://renderer.cfg"

[autoload]

BootGuard="*res://scripts/app/boot_guard.gd"

[display]
window/size/viewport_width=420
window/size/viewport_height=780
window/size/window_width_override=420
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
textures/webp_compression/compression_method=6
textures/webp_compression/lossless_compression_factor=100.0
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/default_filters/use_nearest_mipmap_filter=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[physics]

3d/physics_engine="Jolt Physics"

; Engine configuration file.
; Drums of War: grey-box prototype. Separate from the Fatebound Siege project in ../godot.

config_version=5

[application]

config/name="Drums of War Prototype"
config/description="Art slice of a black-powder card battler."
run/main_scene="res://scenes/Main.tscn"
run/max_fps=60
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/frame_pacing/android/enable_frame_pacing=false
window/frame_pacing/android/swappy_mode=0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=2
mesh_lod/lod_change/threshold_pixels=2.5
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.2, 1)

[shader_globals]

dow_to_sun={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
dow_sun={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
dow_sky={
"type": "vec3",
"value": Vector3(0.2, 0.2, 0.2)
}
dow_fill={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
dow_rim={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
dow_fill_from={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
dow_rim_from={
"type": "vec3",
"value": Vector3(0, 1, 0)
}

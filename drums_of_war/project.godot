; Engine configuration file.
; Drums of War: grey-box prototype. Separate from the Fatebound Siege project in ../godot.

config_version=5

[application]

config/name="Drums of War Prototype"
config/description="Art slice of a black-powder card battler."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.2, 1)

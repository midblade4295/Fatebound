# The iOS build's native plugins: fetched / built by godot/tools/ios_plugins.sh just before an iOS export, never
# committed (Android and desktop builds must not carry or load them)
godot/addons/GodotApplePlugins*/
godot/addons/FateboundNotifyIOS/
godot/ios_plugins/fatebound_notify/bin/
# The store art's HD heroes (godot/tools/meshy_hd.py, ~50 MB each): fetched again from Meshy by their task
# (meshy_hd.py fetch art_sources/store_heroes/<name> <name>); their renders and inputs are kept
art_sources/store_heroes/*/*_hd.glb

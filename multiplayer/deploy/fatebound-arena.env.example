# Public game origins only (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://136-113-125-3.sslip.io
# Needed for the supplied local HTML / file-based Android WebView during this alpha.
# Set to 0 when clients use an explicitly allowlisted HTTPS app origin instead.
ALLOW_LOCAL_CLIENTS=1
# Only trust forwarded IPs when the service is bound to loopback behind the known proxy.
TRUST_PROXY=1
